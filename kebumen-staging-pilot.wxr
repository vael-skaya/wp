  <item>
    <title><![CDATA[Fasilitas Sekolah]]></title>
    <link>http://localhost/staging/kebumen/?p=969</link>
    <pubDate>Mon, 15 Dec 2025 00:09:30 +0000</pubDate>
    <dc:creator><![CDATA[kebumen_admin]]></dc:creator>
    <guid isPermaLink="false">http://localhost/staging/kebumen/?p=969</guid>
    <description></description>
    <content:encoded><![CDATA[<h6>Fasilitas</h6>					<h2>Terlengkap &amp; Modern</h2>												<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/img_kebumen_007-rhkoq2ajs0cuknfbgy40bf8i33otosr1hed8ez8t1c.webp" title="img_kebumen_007" alt="img_kebumen_007" loading="lazy" />											<figcaption>Ruang Guru</figcaption>\n										</figure>\n																	<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/gallery-6-rhko1r6t192wboqgexucc22d1di3ml8xt306waii00.jpg" title="gallery (6)" alt="gallery (6)" loading="lazy" />											<figcaption>Ruang Kelas</figcaption>\n										</figure>\n																	<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/img_fasilitas_007-rgwvlfjtjzycrgekizybpziui03ld628f92kiaohds.webp" title="img_fasilitas_007" alt="img_fasilitas_007" loading="lazy" />											<figcaption>Lapangan Futsal</figcaption>\n										</figure>\n																	<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/img_kebumen_001-rhko9oxqqvy2d57e2dcxe1yhmidomkrc8dbsihineo.webp" title="img_kebumen_001" alt="img_kebumen_001" loading="lazy" />											<figcaption>Laboratorium Komputer</figcaption>\n										</figure>\n																	<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/img_kebumen_009-rhkoqk5hdv1ap8pdkntx4sq9df8sr1pxvurgj8ibr4.webp" title="img_kebumen_009" alt="img_kebumen_009" loading="lazy" />											<figcaption>Perpustakaan</figcaption>\n										</figure>\n																	<figure>\n										<img src="https://smk10novemberkebumen.sch.id/wp-content/uploads/elementor/thumbs/img_fasilitas_003-rgwvlelzd5x2fufxohjp5hrdwm885gyi34f310pvk0.webp" title="img_fasilitas_003" alt="img_fasilitas_003" loading="lazy" />											<figcaption>Masjid</figcaption>\n										</figure>]]></content:encoded>
    <excerpt:encoded></excerpt:encoded>
    <wp:post_id><![CDATA[969]]></wp:post_id>
