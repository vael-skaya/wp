    <content:encoded><![CDATA[<h6>Contact Us</h6>					<h2>Hubungi Kami</h2>							n							Alamat						n									<p>n						Karangmojo, Kec. Karanggayam, Kebumen, Jawa Tengah 54365					</p>n				<a href="mailto:info@smk10novemberkebumen.sch.id" target="_blank" tabindex="-1" aria-label="Email">n								</a>n						<a href="mailto:info@smk10novemberkebumen.sch.id" target="_blank" >n							Email						</a>n									<p>n						info@smk10novemberkebumen.sch.id					</p>n				<a href="http://+622122100609" target="_blank" tabindex="-1" aria-label="Telepon">n								</a>n						<a href="http://+622122100609" target="_blank" >n							Telepon						</a>n									<p>n						(021) 22100609					</p>n				<a href="https://wa.me/6285333859772" target="_blank" tabindex="-1" aria-label="WhatsApp">n								</a>n						<a href="https://wa.me/6285333859772" target="_blank" >n							WhatsApp						</a>n									<p>n						0853 3385 9772 (Bu Dika Agnes. W)<br>0858 7971 7828 (Pak Very Setiawan)					</p>n																	<img width="474" height="585" src="https://smk10novemberkebumen.sch.id/wp-content/uploads/2026/01/gallery-2.jpg" alt="" srcset="https://smk10novemberkebumen.sch.id/wp-content/uploads/2026/01/gallery-2.jpg 474w, https://smk10novemberkebumen.sch.id/wp-content/uploads/2026/01/gallery-2-243x300.jpg 243w" sizes="(max-width: 474px) 100vw, 474px" />																<h2>Contact Form</h2>					<h3>Connect with <b>social media</b></h3>							n					<a target="_blank">n						Facebook-fn						<svg viewBox="0 0 320 512" xmlns="http://www.w3.org/2000/svg"><path d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"></path></svg>					</a>n					<a target="_blank">n						Instagramn						<svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"></path></svg>					</a>n					<a target="_blank">n						Tiktokn						<svg viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M448,209.91a210.06,210.06,0,0,1-122.77-39.25V349.38A162.55,162.55,0,1,1,185,188.31V278.2a74.62,74.62,0,1,0,52.23,71.18V0l88,0a121.18,121.18,0,0,0,1.86,22.17h0A122.18,122.18,0,0,0,381,102.39a121.43,121.43,0,0,0,67,20.14Z"></path></svg>					</a>n			<iframe loading="lazy"n					src="https://maps.google.com/maps?q=SMK%2010%20NOVEMBER%20KEBUMEN&#038;t=m&#038;z=16&#038;output=embed&#038;iwloc=near"n					title="SMK 10 NOVEMBER KEBUMEN"n					aria-label="SMK 10 NOVEMBER KEBUMEN"n			></iframe>]]></content:encoded>
