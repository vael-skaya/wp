am mendukung proses pendidikan yang berkelanjutan","title_size":"div","icon_space":{"unit":"px","size":5,"sizes":[]},"title_bottom_space":{"unit":"px","size":10,"sizes":[]},"icon_size":{"unit":"px","size":42,"sizes":[]},"__globals__":{"primary_color":"globals\/colors?id=389b628","title_typography_typography":"globals\/typography?id=83682a1","title_color":"globals\/colors?id=389b628","description_color":"globals\/colors?id=9cc3a39"},"text_align":"center"},"elements":[],"widgetType":"icon-box"}],"isInner":true}],"isInner":true}],"isInner":false},{"id":"7ba5dac","elType":"container","settings":{"flex_direction":"column","margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding":{"unit":"px","top":"50","right":"10","bottom":"50","left":"10","isLinked":false},"padding_mobile":{"unit":"px","top":"50","right":"10","bottom":"10","left":"10","isLinked":false}},"elements":[{"id":"fa0fdaf","elType":"widget","settings":{"carousel_name":"Image Carousel","carousel":[{"id":1320,"url":"https:\/\/smk10novemberkebumen.sch.id\/wp-content\/uploads\/2026\/01\/brosur_kebumen_001.webp"},{"id":1324,"url":"https:\/\/smk10novemberkebumen.sch.id\/wp-content\/uploads\/2026\/01\/brosur_kebumen_002.webp"}],"thumbnail_size":"full","slides_to_show":"1","arrows_size":{"unit":"px","size":30,"sizes":[]},"arrows_color":"#ECECEC","dots_position":"inside","dots_gap":{"unit":"px","size":5,"sizes":[]},"dots_size":{"unit":"px","size":12,"sizes":[]},"dots_inactive_color":"#9B949463","dots_color":"#FFFFFF","image_border_radius":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"__globals__":{"dots_inactive_color":","dots_color":"}},"elements":[],"widgetType":"image-carousel"}],"isInner":false},{"id":"fd8ef28","elType":"section","settings":{"content_position":"middle","ma